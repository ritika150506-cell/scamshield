{
  "manifest_version": 3,
  "name": "ScamShield",
  "version": "1.1",
  "description": "Checks the page you are visiting for phishing and scams.",
  "permissions": ["tabs", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" }
}